#!/bin/sh
# plotdocs launcher. Inside a packaged PlotDocs it runs the bundled CLI on the
# app's own Node runtime (ELECTRON_RUN_AS_NODE); in a dev checkout it falls
# back to the system node and the local build output. Usually reached through
# a symlink on the PATH, so the real location is resolved first.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

if [ -n "$PLOTDOCS_NODE" ]; then
  exec "$PLOTDOCS_NODE" "$here/plotdocs.cjs" "$@"
fi

case "$here" in
  */Contents/Resources/cli) app="$here/../../MacOS/PlotDocs" ;;
  */resources/cli)
    # Linux install, or the Windows install reached from Git Bash / MSYS
    if [ -x "$here/../../PlotDocs.exe" ]; then app="$here/../../PlotDocs.exe"; else app="$here/../../plotdocs"; fi
    ;;
  *) app="" ;;
esac

if [ -n "$app" ] && [ -x "$app" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$app" "$here/plotdocs.cjs" "$@"
fi

if [ -f "$here/plotdocs.cjs" ]; then
  exec node "$here/plotdocs.cjs" "$@"
fi
exec node "$here/../dist/plotdocs.cjs" "$@"

{
  "name": "@plotdocs/shell",
  "productName": "Plot Docs",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "homepage": "https://plotxyz.ai/plotdocs",
  "private": true,
  "description": "Plot Docs by Plot XYZ.Ai — one AI-native workspace hosting Docs, Sheets, Slides, PDF, Markdown and HTML",
  "main": "out/main/index.js",
  "desktopName": "plotdocs.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@plotdocs/agent-core": "*",
    "@plotdocs/ai-provider": "*",
    "@plotdocs/ai-search": "*",
    "@plotdocs/docs": "*",
    "@plotdocs/docx-engine": "*",
    "@plotdocs/electron-utils": "*",
    "@plotdocs/cli": "*",
    "@plotdocs/i18n": "*",
    "@plotdocs/pipelines": "*",
    "@plotdocs/pptx-engine": "*",
    "@plotdocs/pptx-render": "*",
    "@plotdocs/sheets": "*",
    "@plotdocs/slides": "*",
    "@plotdocs/project-store": "*",
    "@plotdocs/ui": "*",
    "@plotdocs/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.7.6",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "plotxyz.ai"
}
